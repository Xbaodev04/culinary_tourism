{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm ci",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://quan4-api.onrender.com/api/:path*"
    },
    {
      "source": "/static/:path*",
      "destination": "https://quan4-api.onrender.com/static/:path*"
    },
    { "source": "/((?!api(?:/|$)|static(?:/|$)).*)", "destination": "/index.html" }
  ]
}
